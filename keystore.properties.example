# Copy to keystore.properties (gitignored) on every machine you build from.
# Use the SAME keystore file everywhere -- copy it between machines privately (never commit it).
# Without keystore.properties the build falls back to that machine's own debug key, and the
# phone will refuse to install it over a build signed on the other machine.
storeFile=C:/Users/you/.android/debug.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
