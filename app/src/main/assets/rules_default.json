{
  "version": 1,
  "rules": [
    {
      "id": "gpay_debit",
      "name": "Google Pay Debit",
      "package": "com.google.android.apps.nbu.paisa.user",
      "regex": "(?i)\\b(?:paid|sent)\\s*(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.[0-9]{1,2})?)\\s+to\\s+([^\\n]+?)(?=\\s+(?:from|via|using|on|ref|refno|utr|txn|is|was|has|successfully|successful)\\b|\\s*[,;\\n]|\\.(?:\\s|$)|\\s*$)",
      "amountGroup": 1,
      "merchantGroup": 2,
      "method": "UPI",
      "type": "EXPENSE"
    },
    {
      "id": "gpay_debit_amount_first",
      "name": "Google Pay Debit (amount first)",
      "package": "com.google.android.apps.nbu.paisa.user",
      "regex": "(?i)(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.[0-9]{1,2})?)\\s+(?:paid|sent)\\s+to\\s+([^\\n]+?)(?=\\s+(?:from|via|using|on|ref|refno|utr|txn|is|was|has|successfully|successful)\\b|\\s*[,;\\n]|\\.(?:\\s|$)|\\s*$)",
      "amountGroup": 1,
      "merchantGroup": 2,
      "method": "UPI",
      "type": "EXPENSE"
    },
    {
      "id": "phonepe_debit",
      "name": "PhonePe Debit",
      "package": "com.phonepe.app",
      "regex": "(?i)\\bPaid\\s*(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.[0-9]{1,2})?)\\s+to\\s+([^.\\n]+?)(?=\\s+(?:from|via|using|on|ref|refno|utr|txn|is|was|has|successfully|successful)\\b|\\s*[,;\\n]|\\.(?:\\s|$)|\\s*$)",
      "amountGroup": 1,
      "merchantGroup": 2,
      "method": "UPI",
      "type": "EXPENSE"
    },
    {
      "id": "paytm_debit",
      "name": "Paytm Debit",
      "package": "net.one97.paytm",
      "regex": "(?i)(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.[0-9]{1,2})?)\\s*(?:debited|paid|sent)\\b.*?\\b(?:to|at)\\s+([^.\\n]+?)(?=\\s+(?:from|via|using|on|ref|refno|utr|txn|is|was|has|successfully|successful)\\b|\\s*[,;\\n]|\\.(?:\\s|$)|\\s*$)",
      "amountGroup": 1,
      "merchantGroup": 2,
      "method": "UPI",
      "type": "EXPENSE"
    },
    {
      "id": "bank_sms_debit_vpa",
      "name": "Bank SMS Debit to VPA",
      "senderRegex": "(?i).*(?:HDFC|SBI|ICICI|AXIS|KOTAK|PNB|BOB|CANARA|INDUS).*",
      "regex": "(?i)(?:A/c|Account|Acct)\\s*(?:no\\.?)?\\s*[*xX]*(\\d{3,4})\\s*(?:is\\s*)?debited\\s*(?:by|with)?\\s*(?:Rs\\.?|INR|₹)?\\s*([0-9,]+(?:\\.[0-9]{1,2})?).*?(?:to|VPA|at)\\s+([a-zA-Z0-9.\\-_@\\s]+?)(?:\\s+(?:on|dated|ref|utr|rrn)|$|\\.)",
      "accountGroup": 1,
      "amountGroup": 2,
      "merchantGroup": 3,
      "method": "UPI",
      "type": "EXPENSE"
    },
    {
      "id": "bank_sms_card_debit",
      "name": "Credit/Debit Card Spend",
      "senderRegex": "(?i).*(?:HDFC|SBI|ICICI|AXIS|KOTAK|RBL).*",
      "regex": "(?i)(?:Spent|Purchase\\s*of)\\s*(?:Rs\\.?|INR|₹)?\\s*([0-9,]+(?:\\.[0-9]{1,2})?)\\s*(?:on|using)\\s*(?:your\\s*)?(?:Credit|Debit)?\\s*Card\\s*(?:ending\\s*in\\s*|[*xX]*)?(\\d{3,4})\\s*(?:at|for)\\s+([^\\n]+?)(?=\\s+(?:from|via|using|on|ref|refno|utr|txn|is|was|has|successfully|successful)\\b|\\s*[,;\\n]|\\.(?:\\s|$)|\\s*$)",
      "amountGroup": 1,
      "accountGroup": 2,
      "merchantGroup": 3,
      "method": "CREDIT_CARD",
      "type": "EXPENSE"
    },
    {
      "id": "credit_card_bill_payment",
      "name": "Credit Card Bill Payment",
      "regex": "(?i)\\b(?:payment\\s*of|paid)\\s*(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.[0-9]{1,2})?).*?(?:towards|for)?\\s*(?:credit\\s*card\\s*bill|card\\s*ending\\s*in\\s*\\d{3,4}|\\bCRED\\b)",
      "amountGroup": 1,
      "merchantGroup": 0,
      "method": "UPI",
      "type": "INTERNAL_TRANSFER"
    }
  ]
}
